{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RepoTray",
  "version": "0.1.0",
  "identifier": "io.github.fo0.repotray",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RepoTray",
        "width": 480,
        "height": 760,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "maximizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost ws://127.0.0.1:1420 http://127.0.0.1:1420; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "category": "DeveloperTool",
    "shortDescription": "GitHub Actions within reach",
    "copyright": "Copyright (c) 2026 RepoTray contributors",
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": ["English", "German"],
        "installMode": "currentUser"
      },
      "allowDowngrades": false
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
