{
  "name": "repotray",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && svelte-check --tsconfig ./tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "tauri": "tauri",
    "desktop:dev": "tauri dev --features desktop",
    "desktop:build": "tauri build --features desktop",
    "build:installer": "tauri build --features desktop --bundles nsis",
    "icons:generate": "node scripts/generate-icons.mjs",
    "icons:check": "node scripts/generate-icons.mjs --check",
    "verify": "pnpm lint && pnpm icons:check && pnpm check && pnpm test && pnpm release:test && pnpm build",
    "release:test": "node --test scripts/release.test.mjs scripts/updater.test.mjs scripts/release-workflow.test.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^24.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.6.0",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown",
    "*.rs": "rustfmt --edition 2021"
  }
}
